# Copy to .env and adjust. Never commit real secrets or API keys.
# These are demo-only values for local development.
#
# docker compose reads POSTGRES_*, CORS_ORIGINS, IOT_SECRET_KEY, AI_* and VITE_API_BASE_URL from
# this file. DATABASE_URL below is only for a backend running OUTSIDE Docker (uvicorn on the host).

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=grocery
POSTGRES_PASSWORD=grocery_demo_pw
POSTGRES_DB=community_grocery
POSTGRES_PORT=5432

# --- Backend ---
# Host-side URL (backend runs locally with uvicorn, DB runs in Docker)
DATABASE_URL=postgresql+psycopg://grocery:grocery_demo_pw@localhost:5432/community_grocery
# Comma-separated list of allowed browser origins (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000

# --- IoT packet check code (educational demo key, NOT cryptographic security) ---
IOT_SECRET_KEY=demo-secret-not-for-production

# --- AI service (Phase 4). Default: mock provider, NO API key needed ---
AI_PROVIDER=mock
# Optional external providers. Never commit a real key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Required for Anthropic. Gemini defaults to gemini-3.1-flash-lite.
AI_MODEL=
AI_TIMEOUT_SECONDS=20
# Optional: path to a different knowledge base JSON (default: knowledge_base/nutrition_seed.json)
# KNOWLEDGE_BASE_PATH=
